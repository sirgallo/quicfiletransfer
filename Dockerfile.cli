FROM quicdependencies as cli

WORKDIR $HOME/quiccli

COPY cli ./cli
COPY cmd ./cmd
COPY common ./common
COPY md5 ./md5
COPY serialize ./serialize
COPY tls ./tls
COPY vendor ./vendor
COPY go.mod \
  go.sum ./

RUN go build -mod=vendor -o quiccli ./cmd/cli/main.go

EXPOSE 1235

ENTRYPOINT ["./quiccli"]